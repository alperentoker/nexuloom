# Nexuloom Data Intelligence Platform Configuration
NEXULOOM_ENV=production
NEXULOOM_DEBUG=false
UDI_ENV=production
UDI_DEBUG=false
NEXULOOM_SECRET_KEY=change-this-secret-key-in-production
UDI_SECRET_KEY=change-this-secret-key-in-production

# Fernet encryption key for database passwords and credentials.
# IMPORTANT: In production, generate a permanent 32-byte url-safe base64 key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If this key changes or is missing across restarts, stored encrypted passwords cannot be decrypted!
UDI_FERNET_KEY=your-base64-fernet-key-generate-via-fernet-generate-key

# Storage Paths
UDI_DATA_DIR=data
UDI_REPORTS_DIR=reports
UDI_LOGS_DIR=logs

# Query Safety & Limits
UDI_QUERY_TIMEOUT_SECONDS=30
UDI_MAX_ROWS_RETURNED=50000
UDI_DEFAULT_PAGE_SIZE=100
UDI_CACHE_TTL_SECONDS=3600

# Optional Local LLM (Ollama or compatible)
UDI_LLM_ENABLED=true
UDI_LLM_API_URL=http://localhost:11434/api/generate
UDI_LLM_MODEL=llama3:8b
